alert icmp any any -> any any (msg:"[로컬] ICMP 패킷 탐지됨"; sid:1000001; rev:1;)
#alert tcp any any -> any 80 (msg:"[로컬] HTTP 요청 탐지됨"; sid:1000002; rev:1;)
#alert tcp any any -> any 80 (msg:"[로컬] HTTP 요청에 'admin' 포함됨"; content:"admin"; sid:1000004; rev:1;)
#alert icmp 192.168.10.4 any -> 192.168.10.6 any (msg:"[로컬] WinPC에서의 Ping 요청 감지됨"; sid:1000005; rev:1;)


#alert tcp any any -> any any (flags:S; msg:"[로컬] TCP SYN 포트 스캔 탐지됨"; sid:1000006; rev:1;)

